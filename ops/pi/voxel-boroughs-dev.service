[Unit]
Description=Voxel Boroughs private LAN development server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=VOXEL_BOROUGHS_USER_PATH=/home/neonx/builds/voxel-boroughs/runtime
WorkingDirectory=/home/neonx/builds/voxel-boroughs/deploy/current
ExecStart=/home/neonx/builds/voxel-boroughs/deploy/current/bin/voxel-boroughs-server --config /home/neonx/builds/voxel-boroughs/dev.conf --world /home/neonx/builds/voxel-boroughs/dev-world --gameid voxel_boroughs --logfile /home/neonx/builds/voxel-boroughs/runtime/server.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/neonx/builds/voxel-boroughs/runtime /home/neonx/builds/voxel-boroughs/dev-world
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
TasksMax=128
MemoryMax=1G
CPUQuota=80%

[Install]
WantedBy=default.target
